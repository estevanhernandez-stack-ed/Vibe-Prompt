{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-prompt/eval-config",
  "type": "object",
  "required": ["version", "vendors", "costCeiling"],
  "properties": {
    "version": { "type": "string", "const": "0.1" },
    "vendors": {
      "type": "object",
      "properties": {
        "gemini": {
          "type": "object",
          "required": ["defaultModel"],
          "properties": {
            "defaultModel": { "type": "string" },
            "fallbackModel": { "type": ["string", "null"] }
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "defaultModel": { "type": "string" }
          }
        },
        "openai": {
          "type": "object",
          "properties": {
            "defaultModel": { "type": "string" }
          }
        }
      }
    },
    "costCeiling": { "type": "number", "minimum": 0 },
    "fixturePath": { "type": "string" },
    "eval": {
      "type": "object",
      "properties": {
        "injectAttack": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "fixtures": {
              "type": "array",
              "items": { "type": "string" }
            },
            "costCeiling": { "type": "number", "minimum": 0, "default": 0.20 }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "injectionResistance": {
          "type": "object",
          "properties": {
            "userInputVars": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
