{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-prompt/eval-config",
  "type": "object",
  "required": ["version", "vendors", "costCeiling"],
  "properties": {
    "version": { "type": "string", "const": "0.1" },
    "vendors": {
      "type": "object",
      "properties": {
        "gemini": {
          "type": "object",
          "required": ["defaultModel"],
          "properties": {
            "defaultModel": { "type": "string" },
            "fallbackModel": { "type": ["string", "null"] }
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "defaultModel": { "type": "string" }
          }
        },
        "openai": {
          "type": "object",
          "properties": {
            "defaultModel": { "type": "string" }
          }
        }
      }
    },
    "costCeiling": { "type": "number", "minimum": 0 },
    "fixturePath": { "type": "string" },
    "eval": {
      "type": "object",
      "properties": {
        "injectAttack": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "fixtures": {
              "type": "array",
              "items": { "type": "string" }
            },
            "costCeiling": { "type": "number", "minimum": 0, "default": 0.20 }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "injectionResistance": {
          "type": "object",
          "properties": {
            "userInputVars": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "varOriginOverrides": {
          "type": "object",
          "additionalProperties": {
            "enum": ["user-controlled", "system-injected"]
          }
        },
        "f13": {
          "type": "object",
          "description": "v0.6+. F13 (Implicit output format) detection configuration.",
          "properties": {
            "outputFormatExceptions": {
              "type": "array",
              "description": "Prompt IDs (from inventory.json) that intentionally request flexible output. F13 suppresses on these prompts.",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "remediate": {
      "type": "object",
      "properties": {
        "autoApplyThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.90
        },
        "stageThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.70
        },
        "backupRetentionDays": {
          "type": "integer",
          "minimum": 0,
          "default": 30
        },
        "autoHandoffVibeSec": {
          "type": "boolean",
          "default": false,
          "description": "v0.6+. When true AND F12 critical fires, :remediate invokes /vibe-sec:audit automatically. Opt-in only; default false preserves v0.5 banner-only behavior."
        },
        "applyVoiceFrameFixes": {
          "type": "boolean",
          "default": false,
          "description": "v0.6+. When true, Category B voice-frame rewrites follow normal confidence routing (auto-write if confidence ≥0.90). When false (default), voice-frame rewrites always stage for user review regardless of confidence."
        }
      }
    }
  }
}
