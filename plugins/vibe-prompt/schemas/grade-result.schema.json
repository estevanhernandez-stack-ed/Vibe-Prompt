{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-prompt/grade-result",
  "type": "object",
  "required": ["version", "runId", "computedAt", "perPrompt", "appComposite"],
  "properties": {
    "version": { "type": "string", "const": "0.3" },
    "runId": { "type": "string" },
    "computedAt": { "type": "string", "format": "date-time" },
    "sourceAuditRef": { "type": "string" },
    "sourceEvalRunRef": { "type": "string" },
    "perPrompt": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["composite", "dimensions"],
        "properties": {
          "composite": { "type": "integer", "minimum": 1, "maximum": 10 },
          "dimensions": {
            "type": "object",
            "required": ["schemaTightness", "personaConsistency", "instructionClarity", "tokenEfficiency"],
            "properties": {
              "schemaTightness": { "type": "integer", "minimum": 1, "maximum": 10 },
              "personaConsistency": { "type": "integer", "minimum": 1, "maximum": 10 },
              "instructionClarity": { "type": "integer", "minimum": 1, "maximum": 10 },
              "tokenEfficiency": { "type": "integer", "minimum": 1, "maximum": 10 },
              "injectionResistance": { "type": "integer", "minimum": 1, "maximum": 10 }
            }
          },
          "weights": {
            "type": "object",
            "properties": {
              "schemaTightness": { "type": "number" },
              "personaConsistency": { "type": "number" },
              "instructionClarity": { "type": "number" },
              "tokenEfficiency": { "type": "number" },
              "injectionResistance": { "type": "number" }
            }
          },
          "vsBaseline": {
            "type": "object",
            "properties": {
              "delta": { "type": "integer" },
              "status": { "enum": ["improved", "regressed", "stable", "no-prior-baseline"] }
            }
          }
        }
      }
    },
    "appComposite": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 10 },
        {
          "type": "object",
          "properties": {
            "value": { "type": "integer", "minimum": 1, "maximum": 10 },
            "aggregate": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "description": "v0.7+. Cross-workspace aggregate composite. Preserves v0.6 number semantics for back-compat consumers that read appComposite as a single number."
            },
            "perWorkspace": {
              "type": "object",
              "description": "v0.7+. Per-workspace composite scores keyed by workspace name. Value is number (composite score) or null (workspace had no findings).",
              "additionalProperties": {
                "type": ["number", "null"],
                "minimum": 1,
                "maximum": 10
              }
            },
            "workspacesWithNoFindings": {
              "type": "array",
              "description": "v0.7+. Workspace names whose per-workspace composite is null because no findings were emitted against them.",
              "items": { "type": "string" }
            },
            "dimensions": {
              "type": "object",
              "properties": {
                "schemaTightness": { "type": "integer", "minimum": 1, "maximum": 10 },
                "personaConsistency": { "type": "integer", "minimum": 1, "maximum": 10 },
                "instructionClarity": { "type": "integer", "minimum": 1, "maximum": 10 },
                "tokenEfficiency": { "type": "integer", "minimum": 1, "maximum": 10 },
                "injectionResistance": { "type": "integer", "minimum": 1, "maximum": 10 }
              }
            }
          }
        }
      ]
    },
    "appCompositeVsBaseline": {
      "type": "object",
      "properties": {
        "delta": { "type": "integer" },
        "status": { "enum": ["improved", "regressed", "stable", "no-prior-baseline"] }
      }
    },
    "flaggedRegressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["promptId", "dimension", "delta"],
        "properties": {
          "promptId": { "type": "string" },
          "dimension": { "type": "string" },
          "delta": { "type": "integer" },
          "workspaceIdentifier": {
            "type": ["string", "null"],
            "description": "v0.7+. Workspace where the regression was detected (when grade ran in per-workspace mode). null = aggregate-level regression."
          }
        }
      }
    }
  }
}
