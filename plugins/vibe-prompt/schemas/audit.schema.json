{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-prompt/audit",
  "type": "object",
  "required": ["version", "auditedAt", "inventoryRef", "findings", "summary"],
  "properties": {
    "version": { "type": "string", "const": "0.1" },
    "auditedAt": { "type": "string", "format": "date-time" },
    "inventoryRef": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "smell", "severity", "evidence", "recommendation"],
        "properties": {
          "id": {
            "enum": [
              "F1", "F1b", "F2", "F3", "F4", "F5", "F6", "F6-suspect-model",
              "F7", "F9", "F10", "F11", "F12", "F13"
            ]
          },
          "smell": { "type": "string" },
          "severity": { "enum": ["high", "medium", "low", "advisory", "critical"] },
          "handoffHint": { "type": "string" },
          "originFilteredOut": { "type": "boolean" },
          "varOriginUsed": { "enum": ["user-controlled", "system-injected", "unknown"] },
          "composerIdentifier": {
            "type": ["string", "null"],
            "description": "v0.7+. Identifies the composer this finding belongs to (composer.path or first call-site for multi-call-site groups). null = single-composer / pre-v0.7 audit."
          },
          "workspaceIdentifier": {
            "type": ["string", "null"],
            "description": "v0.7+. Identifies the workspace this finding belongs to (workspace name). null = single-workspace / pre-v0.7 audit."
          },
          "consolidatedWith": {
            "type": "array",
            "description": "v0.7+. Finding IDs that this finding is consolidated with into a single remediation diff (used for F10+F11 (+F12-high) consolidation).",
            "items": { "type": "string" }
          },
          "metadata": {
            "type": "object",
            "description": "v0.7+. Open metadata bag for finding-level signals that aren't load-bearing for severity (e.g., composerMultiplicityFlag).",
            "additionalProperties": true
          },
          "apiParameterContext": {
            "type": "object",
            "description": "v0.6+. Populated when F12 fires. Captures the API parameter separation analysis used by F12 API-parameter-aware detection.",
            "properties": {
              "userVarApiParameter": {
                "enum": ["systemInstruction", "contents", "messages", "instructions", "prompt", null]
              },
              "systemInstructionApiParameter": {
                "enum": ["systemInstruction", "contents", "messages", "instructions", "prompt", null]
              },
              "separationVerified": { "type": "boolean" }
            }
          },
          "voiceFrameContradictions": {
            "type": "array",
            "description": "v0.6+. Populated when Category B voice-frame extension fires. Lists detected voice-frame phrases that contradict global-directive voice rules.",
            "items": {
              "type": "object",
              "required": ["phrase", "location", "banSource"],
              "properties": {
                "phrase": { "type": "string" },
                "location": { "type": "string" },
                "banSource": { "type": "string" }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "line"],
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer" },
                "note": { "type": "string" }
              }
            }
          },
          "recommendation": { "type": "string" },
          "scores": {
            "type": "object",
            "properties": {
              "schemaTightness": { "type": "integer", "minimum": 1, "maximum": 10 },
              "personaConsistency": { "type": "integer", "minimum": 1, "maximum": 10 },
              "instructionClarity": { "type": "integer", "minimum": 1, "maximum": 10 },
              "tokenEfficiency": { "type": "integer", "minimum": 1, "maximum": 10 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["totalFindings", "byCategory"],
      "properties": {
        "totalFindings": { "type": "integer" },
        "byCategory": {
          "type": "object",
          "properties": {
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" },
            "advisory": { "type": "integer" }
          }
        }
      }
    },
    "auditGrade": {
      "type": "object",
      "properties": {
        "perPrompt": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "composite": { "type": "integer", "minimum": 1, "maximum": 10 },
              "dimensions": {
                "type": "object",
                "properties": {
                  "schemaTightness": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "personaConsistency": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "instructionClarity": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "tokenEfficiency": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "injectionResistance": {
                    "type": "object",
                    "properties": {
                      "value": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "rationale": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "appComposite": { "type": "integer", "minimum": 1, "maximum": 10 },
        "suggestedWeightOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": { "type": "string" },
              "multiplier": { "type": "number" },
              "rationale": { "type": "string" },
              "appTypeSignal": { "enum": ["consumer", "internal", "mixed"] }
            }
          }
        }
      }
    }
  }
}
