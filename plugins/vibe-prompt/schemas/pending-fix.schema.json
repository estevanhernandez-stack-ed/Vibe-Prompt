{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-prompt/pending-fix",
  "description": "Front-matter shape for .vibe-prompt/remediate/pending/<finding-id>.diff staged fix files. Body is a unified diff; this schema validates only the YAML front-matter.",
  "type": "object",
  "required": [
    "findingId",
    "findingCategory",
    "confidence",
    "targetFile",
    "targetRange",
    "recommendationSource"
  ],
  "properties": {
    "findingId": { "type": "string" },
    "findingCategory": { "enum": ["A", "B", "C"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "targetFile": { "type": "string" },
    "targetRange": { "type": "string" },
    "recommendationSource": { "type": "string" },
    "backupPath": { "type": "string" },
    "postApplyRecommendation": { "type": "string" },
    "versionBumpRequired": { "type": "boolean" },
    "suggestedVersion": { "type": "string" },
    "stagedAt": { "type": "string", "format": "date-time" }
  }
}
