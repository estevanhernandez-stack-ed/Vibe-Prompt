{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibe-prompt/remediate-result",
  "$defs": {
    "diff": {
      "type": "object",
      "required": ["findingId", "findingCategory", "confidence", "targetFile"],
      "properties": {
        "findingId": { "type": "string" },
        "findingCategory": { "enum": ["A", "B", "C", "D-1", "D-2", "D-3"] },
        "subCategory": {
          "type": "string",
          "description": "v0.6+. Sub-category distinguishing fix variants. For Category B: `banned-phrase-removal` (v0.5 default) vs `voice-frame-rewrite` (v0.6 voice-frame extension)."
        },
        "migrationKind": {
          "enum": [
            "D-1-inline-to-registry",
            "D-2-typed-renderer",
            "D-3-model-consolidation"
          ],
          "description": "v0.7+. Migration template that produced this diff. Mirrors findingCategory D-1/D-2/D-3 but is explicit for downstream consumers."
        },
        "consolidatedFindingIds": {
          "type": "array",
          "description": "v0.7+. When this diff closes multiple findings (e.g., F10+F11 consolidation), the additional finding IDs beyond `findingId`.",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "targetFile": { "type": "string" },
        "targetRange": { "type": "string" },
        "backupPath": { "type": "string" },
        "diffBody": { "type": "string" },
        "appliedAt": { "type": "string", "format": "date-time" },
        "stagedPath": { "type": "string" },
        "postApplyRecommendation": { "type": "string" },
        "versionBumpRequired": { "type": "boolean" },
        "suggestedVersion": { "type": "string" }
      }
    },
    "f12Handoff": {
      "type": "object",
      "required": ["promptId", "composerPath"],
      "properties": {
        "promptId": { "type": "string" },
        "composerPath": { "type": "string" },
        "banner": { "type": "string" },
        "severity": { "enum": ["critical", "high"] },
        "autoHandoffInvoked": {
          "type": "boolean",
          "description": "v0.6+. True when --auto-handoff-vibe-sec flag triggered an actual vibe-sec:audit invocation. False or absent = banner-only (v0.5 default behavior)."
        },
        "vibeSecResultPath": {
          "type": "string",
          "description": "v0.6+. Path to the handoff-vibe-sec-<timestamp>.json result file when autoHandoffInvoked succeeded."
        }
      }
    }
  },
  "type": "object",
  "required": [
    "runId",
    "timestamp",
    "auditRunId",
    "totalFindings",
    "diffsByCategory",
    "appliedDiffs",
    "stagedDiffs",
    "inlineOnlyDiffs"
  ],
  "properties": {
    "runId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "auditRunId": { "type": "string" },
    "totalFindings": { "type": "integer", "minimum": 0 },
    "diffsByCategory": {
      "type": "object",
      "properties": {
        "categoryA": { "type": "integer", "minimum": 0 },
        "categoryB": { "type": "integer", "minimum": 0 },
        "categoryC": { "type": "integer", "minimum": 0 }
      }
    },
    "appliedDiffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/diff" }
    },
    "stagedDiffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/diff" }
    },
    "inlineOnlyDiffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/diff" }
    },
    "f12HandoffsEmitted": {
      "type": "array",
      "items": { "$ref": "#/$defs/f12Handoff" }
    },
    "backupBatchPath": { "type": "string" },
    "flags": {
      "type": "object",
      "properties": {
        "autoApply": { "type": "boolean" },
        "interactive": { "type": "boolean" },
        "skipF12": { "type": "boolean" },
        "applyContradictions": { "type": "boolean" },
        "applyInlineToRegistry": {
          "type": "boolean",
          "description": "v0.7+. Flipped by --apply-inline-to-registry; allows Category D-1 diffs to auto-write at confidence >=0.90."
        },
        "applyTypedRenderer": {
          "type": "boolean",
          "description": "v0.7+. Flipped by --apply-typed-renderer; allows Category D-2 diffs to auto-write at confidence >=0.90."
        },
        "applyModelConsolidation": {
          "type": "boolean",
          "description": "v0.7+. Flipped by --apply-model-consolidation; allows Category D-3 diffs to auto-write at confidence >=0.90."
        }
      }
    },
    "consolidatedDiffs": {
      "type": "array",
      "description": "v0.7+. Diffs that close multiple findings as a single change (e.g., F10+F11+F12-high consolidated into one Category C diff).",
      "items": {
        "type": "object",
        "required": ["path", "findingIds", "rationale"],
        "properties": {
          "path": { "type": "string" },
          "findingIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
